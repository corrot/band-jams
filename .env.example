# Postgres connection string (Neon via Vercel Storage sets this automatically)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Shared band password used on the login screen
BAND_PASSWORD=change-me
# Long random string used to sign session cookies
SESSION_SECRET=generate-a-long-random-string
# Vercel Blob token (set automatically when a Blob store is connected)
BLOB_READ_WRITE_TOKEN=
